# Build output — large, generated, not useful for code understanding
build/
.dart_tool/

# Platform boilerplate — generated by Flutter, rarely needs editing
android/
ios/
linux/
web/

# Dependencies and caches
.pub-cache/
.pub/
Pods/
macos/Flutter/ephemeral/
windows/flutter/ephemeral/

# IDE files
.idea/
.vscode/
*.iml

# Binary assets — not readable
assets/icon/
fonts/

# Lock files — not useful for understanding code
pubspec.lock

# macOS system files
.DS_Store

# Generated Dart files
*.g.dart
*.freezed.dart

# Secrets — never read API keys or certificates
*.env
.env.*
secrets.dart
secrets.yaml
*.jks
*.keystore
*.p12
